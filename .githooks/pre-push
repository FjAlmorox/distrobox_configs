#!/usr/bin/env bash
# .githooks/pre-push
# Pre-push hook that runs a full security audit across the repository
# before allowing changes to be pushed to a remote repository.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "🚀 [Pre-Push Hook] Verifying repository security, structure, and integrity before push..."
"$SCRIPT_DIR/pre-commit" --all

echo "📦 [Pre-Push Hook] Validating sandbox structures and script integrity..."
"$SCRIPT_DIR/../tests/validate-sandboxes.sh"

