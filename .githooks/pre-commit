#!/usr/bin/env bash
# .githooks/pre-commit
# Pre-commit hook and security auditor to prevent leaking personal data,
# host paths, credentials, or secrets in the repository.
#
# Automated usage: Executed by Git on every 'git commit'.
# Manual usage: ./.githooks/pre-commit [--all]

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

CURRENT_USER=$(id -un 2>/dev/null || whoami 2>/dev/null || echo "$USER")
MODE="staged"

if [ "$1" = "--all" ] || [ "$1" = "-a" ]; then
    MODE="all"
fi

ERRORS_FOUND=0

if [ "$MODE" = "all" ]; then
    echo -e "${BLUE}🔍 [Security Audit] Scanning ENTIRE repository for secrets or personal data...${NC}"

    # 1. Check local host username across tracked files (ignore generic system/CI users)
    case "$CURRENT_USER" in
        root|runner|runneradmin|ubuntu|node|circleci|travis|"")
            ;;
        *)
            USER_MATCHES=$(git grep -I -w "$CURRENT_USER" -- ':(exclude).githooks/*' || true)
            if [ -n "$USER_MATCHES" ]; then
                echo -e "${RED}❌ ERROR: Detected local username '$CURRENT_USER' in tracked files:${NC}"
                echo "$USER_MATCHES" | head -n 5
                echo -e "${YELLOW}👉 Replace with generic variables (\$USER, \${HOME}) or abstract placeholders.${NC}\n"
                ERRORS_FOUND=1
            fi
            ;;
    esac


    # 2. Check hardcoded host absolute paths
    HOME_MATCHES=$(git grep -I -E "/home/[a-zA-Z0-9_-]+" -- ':(exclude).githooks/*' 2>/dev/null | grep -vE "/home/(\\\$USER|\$\{HOME\}|username|user|<|\{)" || true)
    if [ -n "$HOME_MATCHES" ]; then
        echo -e "${RED}❌ ERROR: Detected fixed absolute paths /home/<user>:${NC}"
        echo "$HOME_MATCHES" | head -n 5
        echo -e "${YELLOW}👉 Use \${HOME} or \$HOME to preserve portability and privacy.${NC}\n"
        ERRORS_FOUND=1
    fi

    # 3. Check private cryptographic keys and certificates
    KEY_MATCHES=$(git grep -I -E "(BEGIN [A-Z ]*PRIVATE KEY|BEGIN CERTIFICATE)" -- ':(exclude).githooks/*' || true)
    if [ -n "$KEY_MATCHES" ]; then
        echo -e "${RED}❌ ERROR: Detected private key blocks or certificates:${NC}"
        echo "$KEY_MATCHES" | head -n 3
        echo -e "${YELLOW}👉 NEVER commit cryptographic keys into the repository.${NC}\n"
        ERRORS_FOUND=1
    fi

    # 4. Check known tokens and API keys
    TOKEN_MATCHES=$(git grep -I -E "(ghp_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9_]{50,}|AKIA[0-9A-Z]{16}|bearer [a-zA-Z0-9_\-\.]{25,})" -- ':(exclude).githooks/*' || true)
    if [ -n "$TOKEN_MATCHES" ]; then
        echo -e "${RED}❌ ERROR: Detected potential tokens or API keys:${NC}"
        echo "$TOKEN_MATCHES" | head -n 3
        ERRORS_FOUND=1
    fi

    # 5. Check plaintext password or secret assignments
    SECRET_MATCHES=$(git grep -I -iE "(password|passwd|secret_key|api_key)\s*=\s*['\"][^'\"]{8,}['\"]" -- ':(exclude).githooks/*' || true)
    if [ -n "$SECRET_MATCHES" ]; then
        echo -e "${RED}❌ ERROR: Detected plaintext password or secret assignments:${NC}"
        echo "$SECRET_MATCHES" | head -n 3
        ERRORS_FOUND=1
    fi

else
    STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM -- ':(exclude).githooks/*')

    if [ -z "$STAGED_FILES" ]; then
        exit 0
    fi

    echo -e "${BLUE}🔍 [Security Audit] Inspecting staged changes for secrets or personal data...${NC}"

    # 1. Check local host username in added lines (ignore generic system/CI users)
    case "$CURRENT_USER" in
        root|runner|runneradmin|ubuntu|node|circleci|travis|"")
            ;;
        *)
            USER_MATCHES=$(git diff --cached -U0 -- ':(exclude).githooks/*' | grep -E "^\+[^\+]" | grep -w "$CURRENT_USER" || true)
            if [ -n "$USER_MATCHES" ]; then
                echo -e "${RED}❌ ERROR: Detected local username '$CURRENT_USER' in staged changes:${NC}"
                echo "$USER_MATCHES" | head -n 5
                echo -e "${YELLOW}👉 Replace with generic variables (\$USER, \${HOME}) or abstract placeholders.${NC}\n"
                ERRORS_FOUND=1
            fi
            ;;
    esac


    # 2. Check hardcoded host paths in added lines
    HOME_PATH_MATCHES=$(git diff --cached -U0 -- ':(exclude).githooks/*' | grep -E "^\+[^\+]" | grep -E "/home/[a-zA-Z0-9_-]+" | grep -vE "/home/(\\\$USER|\$\{HOME\}|username|user|<|\{)" || true)
    if [ -n "$HOME_PATH_MATCHES" ]; then
        echo -e "${RED}❌ ERROR: Detected fixed absolute paths /home/<user>:${NC}"
        echo "$HOME_PATH_MATCHES" | head -n 5
        echo -e "${YELLOW}👉 Use \${HOME} or \$HOME to preserve portability and privacy.${NC}\n"
        ERRORS_FOUND=1
    fi

    # 3. Check private cryptographic keys and certificates
    KEY_MATCHES=$(git diff --cached -U0 -- ':(exclude).githooks/*' | grep -E "^\+[^\+]" | grep -E "(BEGIN [A-Z ]*PRIVATE KEY|BEGIN CERTIFICATE)" || true)
    if [ -n "$KEY_MATCHES" ]; then
        echo -e "${RED}❌ ERROR: Detected private key blocks or certificates:${NC}"
        echo "$KEY_MATCHES" | head -n 3
        echo -e "${YELLOW}👉 NEVER commit cryptographic keys into the repository.${NC}\n"
        ERRORS_FOUND=1
    fi

    # 4. Check known tokens and API keys
    TOKEN_MATCHES=$(git diff --cached -U0 -- ':(exclude).githooks/*' | grep -E "^\+[^\+]" | grep -E "(ghp_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9_]{50,}|AKIA[0-9A-Z]{16}|bearer [a-zA-Z0-9_\-\.]{25,})" || true)
    if [ -n "$TOKEN_MATCHES" ]; then
        echo -e "${RED}❌ ERROR: Detected potential tokens or API keys:${NC}"
        echo "$TOKEN_MATCHES" | head -n 3
        ERRORS_FOUND=1
    fi

    # 5. Check plaintext password or secret assignments
    SECRET_MATCHES=$(git diff --cached -U0 -- ':(exclude).githooks/*' | grep -E "^\+[^\+]" | grep -iE "(password|passwd|secret_key|api_key)\s*=\s*['\"][^'\"]{8,}['\"]" || true)
    if [ -n "$SECRET_MATCHES" ]; then
        echo -e "${RED}❌ ERROR: Detected plaintext password or secret assignments:${NC}"
        echo "$SECRET_MATCHES" | head -n 3
        ERRORS_FOUND=1
    fi
fi

if [ $ERRORS_FOUND -ne 0 ]; then
    echo -e "${RED}🚫 Commit / Operation aborted by privacy and secrets security filter.${NC}"
    echo -e "${YELLOW}Fix affected files or unstage them using 'git reset HEAD <file>'.${NC}"
    exit 1
fi

echo -e "${GREEN}✅ [Security Audit] Verification passed. Zero secrets and zero personal data detected.${NC}"
exit 0
