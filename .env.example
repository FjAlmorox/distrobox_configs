# ==============================================================================
# .env.example - Local Configuration Template for Distrobox Environments
# ==============================================================================
# Copy this file as '.env' in the repository root to apply local customizations.
# The '.env' file is strictly ignored by Git. NEVER commit private keys or secrets.
# All variables below are optional; sensible defaults are applied automatically.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host & Infrastructure Layer (Evaluated by create.sh, enter.sh, distrobox.ini)
# ------------------------------------------------------------------------------
# Base Fedora release tag for all Distrobox containers (default: 44)
# FEDORA_VERSION=44

# Custom base container image (overrides FEDORA_VERSION if specified)
# DISTROBOX_BASE_IMAGE="registry.fedoraproject.org/fedora-toolbox:44"

# Path to the host Workspace directory mounted inside containers (default: $HOME/Workspace)
# WORKSPACE_DIR="${HOME}/Workspace"

# Storage location for isolated container homes (default: $HOME/.local/share/distrobox-homes)
# Useful for storing homes on a fast secondary NVMe drive (e.g. /mnt/nvme/distrobox-homes)
# DISTROBOX_HOMES_DIR="${HOME}/.local/share/distrobox-homes"

# Hardware acceleration and passthrough flags (default: --device /dev/kvm --device /dev/dri)
# Set to empty ("") when running on cloud VMs or headless servers without KVM/GPU
# DISTROBOX_ADDITIONAL_FLAGS="--device /dev/kvm --device /dev/dri"

# Native NVIDIA GPU passthrough (0 = false, 1 = true, default: 0)
# DISTROBOX_NVIDIA=0

# ------------------------------------------------------------------------------
# 2. Network & Corporate Proxy Settings (Optional)
# ------------------------------------------------------------------------------
# HTTP_PROXY="http://proxy.example.com:8080"
# HTTPS_PROXY="http://proxy.example.com:8080"
# NO_PROXY="localhost,127.0.0.1"

# ------------------------------------------------------------------------------
# 3. Java / JVM Sandbox Configuration (java-dev/setup.sh)
# ------------------------------------------------------------------------------
# Default Java LTS version to install via SDKMAN! (default: 21)
# JAVA_DEFAULT_VERSION=21

# Install graphical libraries (GTK3, X11, fonts, audio) for desktop tools/IDEs (default: true)
# Set to 'false' for an ultra-lightweight, fast headless backend/CLI sandbox
# INSTALL_GUI=true

# Complementary build tools (default: true)
# INSTALL_GRADLE=true
# INSTALL_MAVEN=true
# INSTALL_KOTLIN=true

# Memory flags for Gradle daemon / compiler (optional)
# GRADLE_OPTS="-Dorg.gradle.jvmargs=-Xmx4g"

# ------------------------------------------------------------------------------
# 4. Android Sandbox Configuration (android-dev/setup.sh)
# ------------------------------------------------------------------------------
# Target Android SDK API version to compile against (default: 35)
# ANDROID_COMPILE_SDK=35

# Android Build-Tools version (default: 35.0.0)
# ANDROID_BUILD_TOOLS="35.0.0"

# Android Emulator system image API level (default: 34)
# ANDROID_EMULATOR_API=34

# Download emulator system image and create AVD (default: true)
# Set to 'false' to save ~1.5 GB of download and speed up setup for pure CLI/Gradle builds
# INSTALL_EMULATOR=true

# Android Virtual Device (AVD) name and hardware profile
# AVD_NAME="Pixel_6_API_34"
# AVD_DEVICE_PROFILE="pixel_6"
