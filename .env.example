# .env.example - Environment variables template for local customizations
# Copy this file as '.env' or export environment variables on the host.
# NEVER commit '.env' files containing real values or credentials.

# Path to the host Workspace directory (default: $HOME/Workspace)
# WORKSPACE_DIR="${HOME}/Workspace"

# Corporate proxy settings (optional)
# HTTP_PROXY="http://proxy.example.com:8080"
# HTTPS_PROXY="http://proxy.example.com:8080"
# NO_PROXY="localhost,127.0.0.1"

# Memory options for Gradle / Java builds (optional)
# GRADLE_OPTS="-Dorg.gradle.jvmargs=-Xmx4g"
